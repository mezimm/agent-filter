<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agent-filter.broker</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/lib/agent-filter/venv/bin/python3</string>
        <string>-m</string>
        <string>approval_broker.broker</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/usr/local/lib/agent-filter</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/usr/local/var/agent-filter/broker.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/agent-filter/broker.log</string>
</dict>
</plist>
